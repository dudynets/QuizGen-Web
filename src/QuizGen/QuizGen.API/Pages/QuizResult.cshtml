@page
@model QuizGen.API.Pages.QuizResultModel
@{
    ViewData["Title"] = "Quiz Results";
}

<div class="py-4">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.QuizResult != null)
    {
        <div class="card">
            <div class="card-header">
                <h2 class="mb-0">Quiz Results</h2>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h4>@Model.QuizResult.QuizName</h4>
                        <p class="text-muted">Completed on @Model.QuizResult.FinishedAt.ToString("g")</p>
                    </div>
                    <div class="col-md-6 text-end">
                        <h3 class="score-display">Score: @Math.Round(Model.QuizResult.Score)%</h3>
                        <p>@Model.QuizResult.CorrectAnswers out of @Model.QuizResult.TotalQuestions correct</p>
                    </div>
                </div>

                <div class="list-group">
                    @foreach (var question in Model.QuizResult.Questions)
                    {
                        <div class="list-group-item bg-surface">
                            <h5 class="mb-3">@question.Text</h5>
                            <div class="mb-2">
                                <strong>Your answer:</strong>
                                @if (question.Answers.Any(a => a.WasSelected))
                                {
                                    <span class="d-inline-flex flex-wrap">
                                        @foreach (var answer in question.Answers.Where(a => a.WasSelected))
                                        {
                                            <span class="@(answer.IsCorrect ? "correct-answer" : "incorrect-answer")">@answer.Text</span>
                                            @if (!answer.Equals(question.Answers.Where(a => a.WasSelected).Last()))
                                            {
                                                <span>,&nbsp;</span>
                                            }
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="incorrect-answer">No answer selected</span>
                                }
                            </div>
                            @if (!question.IsCorrect)
                            {
                                <div class="correct-answer">
                                    <strong>Correct answer:</strong> @(string.Join(", ", question.Answers.Where(a => a.IsCorrect).Select(a => a.Text)) ?? "No correct answer")
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(question.Explanation))
                            {
                                <div class="mt-2 answer-explanation">
                                    @question.Explanation
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <a href="/QuizList" class="btn btn-outline-primary">
                        Back to Quizzes
                    </a>
                    <a href="/quiz/@Model.AttemptId/try" class="btn btn-primary ms-2">
                        Try Again
                    </a>
                </div>
            </div>
        </div>
    }
</div> 