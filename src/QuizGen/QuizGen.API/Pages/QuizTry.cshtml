@page
@model QuizGen.API.Pages.QuizTryModel
@{
    ViewData["Title"] = "Take Quiz";
}

<div class="quiz-try">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }
    
    @if (Model.QuizTry != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">@Model.QuizTry.QuizName</h1>
                @if (!string.IsNullOrEmpty(Model.QuizTry.QuizDescription))
                {
                    <p class="text-muted mb-2">@Model.QuizTry.QuizDescription</p>
                }
                else if (!string.IsNullOrEmpty(Model.QuizTry.QuizPrompt))
                {
                    <p class="text-muted mb-2">@Model.QuizTry.QuizPrompt</p>
                }
                <div class="text-muted">
                    Question @(Model.QuizTry.CurrentQuestionIndex + 1) of @Model.QuizTry.TotalQuestions
                </div>
            </div>
            <div class="progress" style="width: 100px; height: 4px;">
                <div class="progress-bar" role="progressbar" 
                     style="width: @(((Model.QuizTry.CurrentQuestionIndex + 1) * 100) / Model.QuizTry.TotalQuestions)%">
                </div>
            </div>
        </div>

        <div class="question">
            <form method="post" asp-page-handler="SubmitAnswer">
                <input type="hidden" asp-for="QuizId" />
                <input type="hidden" asp-for="AttemptId" />
                
                <div class="mb-4">
                    <h2 class="question-title">@Model.QuizTry.Questions[Model.QuizTry.CurrentQuestionIndex].Text</h2>
                    @if (Model.QuizTry.Questions[Model.QuizTry.CurrentQuestionIndex].Type == "multi-select")
                    {
                        <div class="text-muted">
                            Select all that apply
                        </div>
                    }
                </div>

                <div class="options">
                    @foreach (var answer in Model.QuizTry.Questions[Model.QuizTry.CurrentQuestionIndex].AnswerOptions)
                    {
                        <label class="option">
                            @if (Model.QuizTry.Questions[Model.QuizTry.CurrentQuestionIndex].Type == "multi-select")
                            {
                                <div class="d-flex align-items-center">
                                    <input type="checkbox" 
                                           name="SelectedAnswerIds" 
                                           value="@answer.Id" 
                                           class="form-check-input me-3">
                                    <span>@answer.Text</span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center">
                                    <input type="radio" 
                                           asp-for="SelectedAnswerId" 
                                           value="@answer.Id" 
                                           class="form-check-input me-3">
                                    <span>@answer.Text</span>
                                </div>
                            }
                        </label>
                    }
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="/QuizList" class="btn btn-outline-primary">
                        Exit Quiz
                    </a>
                    <button type="submit" class="btn btn-primary">
                        Next Question
                    </button>
                </div>
            </form>
        </div>
    }
</div> 