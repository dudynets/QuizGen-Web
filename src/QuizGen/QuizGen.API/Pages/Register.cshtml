@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="form-container">
    <div class="text-center mb-5">
        <h2>Create Account</h2>
        <p class="text-muted">Join QuizGen</p>
    </div>
    
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }
    
    <form id="register-form" method="post">
        <div class="mb-4">
            <label asp-for="RegisterRequest.Name" class="form-label">Full Name</label>
            <input asp-for="RegisterRequest.Name" class="form-control" placeholder="Enter your full name" />
            <span asp-validation-for="RegisterRequest.Name" class="text-danger"></span>
        </div>
        
        <div class="mb-4">
            <label asp-for="RegisterRequest.Username" class="form-label">Username</label>
            <input asp-for="RegisterRequest.Username" class="form-control" placeholder="Choose a username" />
            <span asp-validation-for="RegisterRequest.Username" class="text-danger"></span>
        </div>
        
        <div class="mb-4">
            <label asp-for="RegisterRequest.Password" class="form-label">Password</label>
            <input asp-for="RegisterRequest.Password" class="form-control" type="password" placeholder="Create a password" />
            <span asp-validation-for="RegisterRequest.Password" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="RegisterRequest.OpenAiApiKey" class="form-label">OpenAI API Key</label>
            <input asp-for="RegisterRequest.OpenAiApiKey" class="form-control" type="password" placeholder="Enter your OpenAI API key" />
            <div class="form-text text-muted">
                Required for quiz generation. Your key is secure.
            </div>
            <span asp-validation-for="RegisterRequest.OpenAiApiKey" class="text-danger"></span>
        </div>
        
        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">Create Account</button>
            <a href="/Login" class="btn btn-outline-primary">Sign In</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 