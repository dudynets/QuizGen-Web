@page
@model QuizListModel
@{
    ViewData["Title"] = "My Quizzes";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>My Quizzes</h1>
        <a href="/CreateQuiz" class="btn btn-primary">Create New Quiz</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.Quizzes != null && Model.Quizzes.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var quiz in Model.Quizzes)
            {
                <div class="col">
                    <div class="card h-100 quiz-card">
                        <div class="card-body">
                            <h5 class="card-title mb-2">@quiz.Name</h5>
                            <div class="mb-3">
                                <span class="badge bg-primary">@quiz.Difficulty</span>
                                <span class="badge bg-secondary">@quiz.NumQuestions questions</span>
                            </div>
                            <p class="card-text text-muted small mb-3">@quiz.Prompt</p>
                            <div class="text-muted small mb-3">
                                Created: @quiz.CreatedAt.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex gap-2">
                                <a href="/QuizDetails/@quiz.Id" class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                                <a href="/quiz/@quiz.Id/try" class="btn btn-sm btn-primary">
                                    Start
                                </a>
                                <button class="btn btn-sm btn-outline-danger ms-auto" 
                                        onclick="confirmDelete(@quiz.Id, '@quiz.Name')">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h3 class="mb-3">No Quizzes Yet</h3>
            <p class="text-muted mb-4">Start creating quizzes to test your knowledge.</p>
            <a href="/CreateQuiz" class="btn btn-primary">Create Your First Quiz</a>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete "<span id="quizName" class="fw-bold"></span>"?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post">
                    <input type="hidden" id="quizIdToDelete" name="quizId" />
                    <button type="submit" class="btn btn-danger">Delete Quiz</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(quizId, quizName) {
            document.getElementById('quizIdToDelete').value = quizId;
            document.getElementById('quizName').innerText = quizName;
            
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }
    </script>
} 